{
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun run --filter @repo/api test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "check:max-lines": "bun run scripts/check-max-lines.ts",
    "check:staged-types": "bun run scripts/check-staged-types.ts",
    "check:no-middleware": "bun run scripts/check-no-middleware.ts",
    "check:banned-deps": "bun run scripts/check-banned-deps.ts",
    "check:doc-paths": "bun run scripts/check-doc-paths.ts",
    "check:staged-docs": "bun run scripts/check-staged-docs.ts",
    "docs:internal": "cd docs-internal && bun x --bun mintlify dev --no-open",
    "docs:public": "cd docs-public && bun x --bun mintlify dev --no-open",
    "docs:validate": "cd docs-internal && bun x --bun mintlify validate && cd ../docs-public && bun x --bun mintlify validate",
    "codegen:swift": "bun scripts/codegen-swift.ts",
    "codegen:dart": "bun scripts/codegen-dart.ts",
    "codegen": "bun scripts/codegen-swift.ts && bun scripts/codegen-dart.ts",
    "games:bootstrap": "bun scripts/games/cli.ts bootstrap",
    "games:doctor": "bun scripts/games/cli.ts doctor",
    "games:list": "bun scripts/games/cli.ts list",
    "games:format": "bun scripts/games/cli.ts format",
    "games:format:check": "bun scripts/games/cli.ts format --check",
    "games:analyze": "bun scripts/games/cli.ts analyze",
    "games:test": "bun scripts/games/cli.ts test",
    "games:test:tooling": "bun test --max-concurrency=1 scripts/games/*.test.ts",
    "games:parity": "bun scripts/games/parity.ts",
    "games:qa": "bun scripts/games/qa.ts",
    "games:validate": "bun scripts/games/cli.ts validate",
    "games:validate:strict": "bun scripts/games/cli.ts validate --strict",
    "games:content:validate": "bun scripts/games/cli.ts content validate",
    "games:run": "bun scripts/games/cli.ts run",
    "games:build": "bun scripts/games/cli.ts build",
    "games:affected": "bun scripts/games/cli.ts affected",
    "games:generate": "bun scripts/games/cli.ts generate",
    "games:validate-generated": "bun scripts/games/cli.ts validate-generated",
    "games:icons": "bun scripts/games/icons.ts",
    "games:icons:check": "bun scripts/games/icons.ts --check",
    "games:config": "bun scripts/games/config.ts",
    "games:native": "bun scripts/games/cli.ts native",
    "games:xcodegen": "bun scripts/games/xcodegen.ts",
    "games:metadata": "bun scripts/games/cli.ts metadata",
    "games:codegen": "bun scripts/games/cli.ts codegen",
    "knip": "DATABASE_URL=postgresql://knip.invalid/knip knip",
    "knip:ci": "DATABASE_URL=postgresql://knip.invalid/knip knip --reporter compact",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "20.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@types/node": "^20.11.17",
    "bun-types": "1.3.3",
    "husky": "^9.1.7",
    "knip": "6.36.0",
    "lint-staged": "^15.2.10",
    "native": "workspace:*",
    "secretlint": "^12.3.1",
    "shadcn": "^3.6.0",
    "sharp": "0.34.5",
    "turbo": "^2.6.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "name": "expo-with-next",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/expo/*"
  ]
}
