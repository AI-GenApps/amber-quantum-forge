# Copy to .env (root) for local development. Each app reads from its own
# scope at runtime; on Vercel set the relevant subset on each project.

# ---- Database (used by @repo/db, web server, and @repo/api) ----
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- Firebase Admin SDK (server-side, used by @repo/api and admin scripts) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the multi-line private key with \n escapes; the loader converts them back.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Vercel Blob (used by @repo/api profile picture uploads) ----
BLOB_READ_WRITE_TOKEN=

# ---- Web admin (apps/web) ----
# Random secret >= 32 chars. Signs the admin_session cookie.
ADMIN_SESSION_SECRET=
# Transitional allowlist of Firebase UIDs allowed into /admin while bootstrapping.
# Once an admin has been granted via `bun --cwd packages/api run grant-admin <uid>`
# this can be removed.
ADMIN_UIDS=

# ---- Firebase Web SDK (apps/web, exposed to browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Native (apps/native) ----
# Base URL for the API hosted by apps/web. e.g. http://localhost:4001/api
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
