<?xml version="1.0" encoding="utf-8"?>
<!-- android:allowBackup is false, so Android takes no backup of this app. These rules are kept
     consistent anyway (every domain excluded) for API 23-30 devices and lint. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
