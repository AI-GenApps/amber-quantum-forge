#!/bin/sh

# Pre-commit hook: ensure staged .ts/.tsx files (excluding tests) are under 800 lines

MAX_LINES=800
FAILED=0

for file in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -vE '\.(test|spec)\.(ts|tsx)$' | grep -vE '__tests__/'); do
  if [ ! -f "$file" ]; then
    continue
  fi

  lines=$(wc -l < "$file" | tr -d ' ')

  if [ "$lines" -gt "$MAX_LINES" ]; then
    echo "ERROR: $file has $lines lines (max $MAX_LINES)."
    FAILED=1
  fi
done

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "Please break down the larger files into smaller files to ensure long-term maintainability."
  exit 1
fi

exit 0
