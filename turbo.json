{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "IOS_DEVELOPMENT_TEAM",
    "IOS_DISTRIBUTION_TEAM",
    "IOS_EXPORT_OPTIONS_PLIST",
    "ANDROID_KEYSTORE_PATH",
    "ANDROID_KEY_ALIAS",
    "ANDROID_KEY_PASSWORD",
    "ANDROID_STORE_PASSWORD",
    "GAME_TOKEN_ISSUER",
    "GAME_TOKEN_AUDIENCE",
    "GAME_TOKEN_SECRET_MERGE_RELAY_DEBUG",
    "GAME_TOKEN_SECRET_MERGE_RELAY_STAGING",
    "MERGE_RELAY_LOCAL_API_URL"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
