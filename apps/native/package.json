{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "update:production": "eas update --channel production --message",
    "update:preview": "eas update --channel preview --message"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^21.5.0",
    "@react-native-firebase/auth": "^21.5.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-firebase/messaging": "^21.5.0",
    "@react-native-google-signin/google-signin": "^12.1.0",
    "@repo/analytics": "workspace:*",
    "@repo/ui": "*",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "expo": "~55.0.19",
    "expo-apple-authentication": "~55.0.0",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.30",
    "expo-device": "~55.0.0",
    "expo-haptics": "^55.0.14",
    "expo-image": "^55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.13",
    "expo-status-bar": "~55.0.0",
    "expo-system-ui": "~55.0.16",
    "expo-updates": "~55.0.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-purchases": "^9.6.10",
    "react-native-purchases-ui": "^9.6.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "whatwg-fetch": "^3.6.20",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.11.17",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~55.0.0",
    "jest": "^29.6.3",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      },
      "install": {
        "exclude": [
          "@types/react",
          "@types/react-dom"
        ]
      }
    }
  }
}
