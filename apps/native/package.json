{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "update:production": "eas update --channel production --message",
    "update:preview": "eas update --channel preview --message"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.16",
    "@plugin/expo-auth": "workspace:*",
    "@plugin/expo-chat-module": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "@react-native-firebase/crashlytics": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-native-google-signin/google-signin": "^12.1.0",
    "@tanstack/react-query": "^5.100.9",
    "expo": "^56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-build-properties": "~56.0.22",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.22",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.20",
    "expo-linking": "~56.0.15",
    "expo-notifications": "~56.0.20",
    "expo-router": "~56.2.14",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-purchases": "^9.6.10",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.11.17",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~56.0.0",
    "jest": "^29.6.3",
    "typescript": "^5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      },
      "install": {
        "exclude": [
          "@types/react",
          "@types/react-dom",
          "typescript"
        ]
      }
    }
  }
}
